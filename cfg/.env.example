# Long random string. Every request to the hub (and every heartbeat from a
# remote device) must send this as: Authorization: Bearer <HUB_TOKEN>
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
HUB_TOKEN=changeme-generate-a-long-random-token

# Bind address. 0.0.0.0 makes the hub reachable from other devices on the LAN.
HUB_HOST=0.0.0.0
HUB_PORT=8080

# Path to the device registry, relative to the project root.
DEVICES_FILE=cfg/devices.json

# Seconds since a device's last heartbeat before it's considered offline.
HEARTBEAT_TIMEOUT=90